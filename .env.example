# Telegram Bot Settings
BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
BOT_NAME="Diamonds.land"

# Admin Settings - Comma-separated list of user IDs
ADMIN_IDS="YOUR_USER_ID"

# Database and File Paths - No trailing slashes
DATABASE_PATH="data/bot.db"
CONTENT_DIR="content"
LOG_DIR="logs"

# Security Settings
MAX_LOGIN_ATTEMPTS=5
LOGIN_TIMEOUT_MINUTES=10

# --- Optional Settings ---
# Set to True to automatically approve new users (NOT RECOMMENDED for this project)
AUTO_APPROVE=False
# Set to True for verbose logging
DEBUG=False
# Set to True to stop the bot from responding to users (admins still have access)
MAINTENANCE_MODE=False
